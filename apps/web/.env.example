# Server side Solana RPC used to fetch blocks (mainnet history).
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
# Wallet network for minting: devnet or mainnet-beta.
NEXT_PUBLIC_SOLANA_NETWORK=devnet
# Mainnet minting stays off unless both of these are "true".
NEXT_PUBLIC_ENABLE_MAINNET=false
ENABLE_MAINNET=false
# Absolute site URL used in NFT metadata links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Postgres for slot claims and mint records.
DATABASE_URL=postgresql://slotart:slotart@localhost:5433/slotart
# OpenRouter for the text and image to math page.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen2.5-vl-72b-instruct:free
# Set to 1 to answer /api/generate with presets instead of calling OpenRouter.
LLM_MOCK=0
